#!/usr/bin/env python3

import json
import os
import sys
from pathlib import Path

try:
    if startup := os.environ.get("LONGTAILS_STARTUP"):
        line = "Startup: " + json.dumps(json.loads(startup), ensure_ascii=False)
        path = Path(sys.argv[1])
        if line not in path.read_text(encoding="utf-8").splitlines():
            with path.open("a", encoding="utf-8") as message:
                message.write(f"\n\n{line}\n")
except Exception:
    pass
