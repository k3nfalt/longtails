 C, ?_, ?_⟩\n        · rw [depth_succ T j hb]\n          omega\n        · rw [repr_succ T j hb, hC, Multiset.add_cons]\n        · rw [Multiset.card_cons, hcard, depth_succ T j hb]\n          omega","outputs.Proofs.BirchSgdConvergence.ancestors_succ":"by\n  exact fold_succ T {0} (fun k s => insert (k + 1) s) j hb","outputs.Proofs.BirchSgdConvergence.branch_depth":"by\n  induction k with\n  | zero => rw [hm.1]; rfl\n  | succ k ih =>\n    have h := depth_succ T (m (k + 1) - 1) (hT _).1\n    rw [← branch_succ T m hm k, (hm.2 k).2, ih] at h\n    exact h","outputs.Proofs.BirchSgdConvergence.branch_repr_succ":"by\n  have h := repr_succ T (m (k + 1) - 1) (hT _).1\n  rw [← branch_succ T m hm k, (hm.2 k).2] at h\n  exact h","outputs.Proofs.BirchSgdConvergence.branch_succ":"by\n  exact (Nat.succ_pred_eq_of_pos (hm.2 k).1).symm","outputs.Proofs.BirchSgdConvergence.depth_succ":"by\n  exact fold_succ T 0 (fun _ n => n + 1) j hb","outputs.Proofs.BirchSgdConvergence.foldHist_stable":"by\n  induction k with\n  | zero =>\n    obtain rfl : j = 0 := Nat.le_zero.mp hj\n    rfl\n  | succ k ih =>\n    rcases Nat.lt_or_ge j (k + 1) with h | h\n    · have h' : j ≤ k := Nat.lt_succ_iff.mp h\n      change (if j ≤ k then T.foldHist init step k j\n        else step k (T.foldHist init step k (T.base k))) = _\n      rw [ite_eq_left h', ih h']\n    · obtain rfl : j = k + 1 := le_antisymm hj h\n      rfl","outputs.Proofs.BirchSgdConvergence.fold_succ":"by\n  change (if j + 1 ≤ j then T.foldHist init step j (j + 1)\n    else step j (T.foldHist init step j (T.base j))) = _\n  rw [ite_eq_right (Nat.not_succ_le_self j), foldHist_stable T init step j (T.base j) hb]","outputs.Proofs.BirchSgdConvergence.realize_stable":"by\n  induction k with\n  | zero =>\n    refine ⟨fun j hj => ?_, fun c hc => absurd hc (Nat.not_lt_zero c)⟩\n    obtain rfl : j = 0 := Nat.le_zero.mp hj\n    rfl\n  | succ k ih =>\n    have hrk : g ((T.realize gamma x0 g η k).nodes (T.point k)) (η k) =\n        T.reply gamma x0 g η k := by\n      rw [ih.1 _ (hT k).2.1]\n      rfl\n    refine ⟨fun j hj => ?_, fun c hc => ?_⟩\n    · rcases Nat.lt_or_ge j (k + 1) with h | h\n      · have hne : j ≠ k + 1 := Nat.ne_of_lt h\n        change (if j = k + 1 then _ else (T.realize gamma x0 g η k).nodes j) = _\n        rw [ite_eq_right hne, ih.1 j (Nat.lt_succ_iff.mp h)]\n      · obtain rfl : j = k + 1 := le_antisymm hj h\n        rfl\n    · change (if c = k then g ((T.realize gamma x0 g η k).nodes (T.point k)) (η k)\n        else (T.realize gamma x0 g η k).replies c) = _\n      by_cases hck : c = k\n      · rw [ite_eq_left hck, hrk, hck]\n      · rw [ite_eq_right hck, ih.2 c (by omega)]","outputs.Proofs.BirchSgdConvergence.repr_succ":"by\n  exact fold_succ T 0 (fun k M => T.grad k ::ₘ M) j hb","outputs.Proofs.BirchSgdConvergence.vertex_eq_repr":"by\n  induction j using Nat.strong_induction_on with\n  | _ j ih =>\n    rcases j with _ | j\n    · change x0 = x0 - gamma • ((0 : Multiset ℕ).map (T.reply gamma x0 g η)).sum\n      simp\n    · have hb := (hT j).1\n      rw [vertex_succ T hT gamma x0 g η j, ih _ (Nat.lt_succ_of_le hb), repr_succ T j hb,\n        Multiset.map_cons, Multiset.sum_cons, smul_add]\n      module","outputs.Proofs.BirchSgdConvergence.vertex_succ":"by\n  have hs := realize_stable T hT gamma x0 g η j\n  have hrk : g ((T.realize gamma x0 g η j).nodes (T.point j)) (η j) =\n      T.reply gamma x0 g η j := by\n    rw [hs.1 _ (hT j).2.1]\n    rfl\n  change (if j + 1 = j + 1 then (T.realize gamma x0 g η j).nodes (T.base j) - gamma •\n      (if T.grad j = j then g ((T.realize gamma x0 g η j).nodes (T.point j)) (η j)\n        else (T.realize gamma x0 g η j).replies (T.grad j))\n    else (T.realize gamma x0 g η j).nodes (j + 1)) = _\n  rw [ite_eq_left rfl, hs.1 _ (hT j).1]\n  by_cases hg : T.grad j = j\n  · rw [ite_eq_left hg, hrk, hg]\n  · rw [ite_eq_right hg, hs.2 _ (lt_of_le_of_ne (hT j).2.2 hg)]","outputs.Proofs.BirchSgdConvergence.vertex_zero":"by\n  exact rfl","outputs.Proofs.BirchSgdConvergence.zero_mem_ancestors":"by\n  induction y using Nat.strong_induction_on with\n  | _ y ih =>\n    rcases y with _ | j\n    · exact Finset.mem_singleton_self 0\n    · rw [ancestors_succ T j (hT j).1]\n      exact Finset.mem_insert_of_mem (ih _ (Nat.lt_succ_of_le (hT j).1))"},"rejected_bases":["cf70414706dc82d2780ada4db9ba35d1d5f67a44595547cfd54d65ce8488c264"],"repository":"/home/jovyan/pqviet/theorem_extension/auto-math-ringmaster-interface","repository_commit":"91974b1718e14bc8226478b77b0d811e981d2679","reviewer":"reviewer","schema":1,"source":"5d7d27b89761b3146faca5b11619114d88068d609f52cf4e66d40ff59674fcd8","statement_validation":"f3b48b4a1f42c00a79b67045d43feb79fd10e7043daa298af3a96edcb577670c","target":"thm:main","timeout":3600,"units":{"alg":{"accepted":true,"candidate":"353853e267408a1a15a215763afb88f364c776ffa0b13ac6f06325134342fca6","inventory":"8d5e8c0a63ebf7bfb91f0fa09d45eacb28858a2ba11b34f75574e82b50a83120","review":"082234e0b356254e80b130985fc983dcb38200e5e6a52dd3f48298e6417f443f"},"conv":{"accepted":true,"candidate":"5dc5ba22e1a7905269cb88d860765d1460ad7914a071a10998dba99d0767f760","inventory":"4d21573fef36a5ab99aa16a0fcf726c79732e46488c94086b9612412c16ed7f5","review":"bae042042be97c55a183cb43a0104d4a1d1a2a164d7d6d471147e2da0271bc01"},"public":{"accepted":true,"candidate":"07e62316c668d60e166671ca48235954c2f5366268c9330bdad4b832b99203f1","inventory":"25d98127d1c642711abfe813c796959c0f2b049ec7e9c566e7877604ae872974","review":"e03494b2cf3777f0861673781e3cac957e9eb39eac0e6e3a62a588f015f24889"},"setup":{"accepted":true,"candidate":"76927ea0a99724fa3c63b16c211264918ad1dfd01fd5f612d34b766f77614df9","inventory":"c218c644288f729e4e61b1790763a07187520c4142f9e5569c5f5a6e5fd3375c","review":"0079ef89f91e6efd6e98088081a52e13d19b85c9facc3764c5423bbb49c936ed"}},"version":"0.1.0"}
