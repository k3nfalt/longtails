#!/usr/bin/env python3

import os
import subprocess
import sys


def main():
    root = subprocess.check_output(['git', 'rev-parse', '--show-toplevel']).strip()
    os.chdir(os.fsdecode(root))
    branch = subprocess.run(
        ['git', 'symbolic-ref', '--quiet', '--short', 'HEAD'], stdout=subprocess.PIPE,
    )
    if branch.returncode == 1:
        return
    branch.check_returncode()
    if branch.stdout.strip() != b'main-bot':
        return
    paths = subprocess.check_output([
        'git', 'diff', '--cached', '--name-only', '--diff-filter=AM', '--no-renames',
        '-z', '--', 'LongTails/Theorems/',
    ]).split(b'\0')
    for path in paths:
        if not path.endswith(b'.lean'):
            continue
        filename = os.fsdecode(path)
        if subprocess.run(['git', 'diff', '--quiet', '--', filename]).returncode:
            sys.exit(f'Stage all changes to {filename} before running the comparator.')
        subprocess.run([sys.executable, 'run_comparator.py', filename], check=True)


if __name__ == '__main__':
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
